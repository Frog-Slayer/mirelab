# 이 파일을 application-secret.properties 로 복사해서 채운다 (gitignore 됨).
# 환경변수(MIRELAB_JWT_SECRET 등)로 넘겨도 되고, 그쪽이 우선이다.

# HS256 서명 키 — 32바이트(256bit) 이상이어야 한다. 예: openssl rand -base64 48
mirelab.jwt.secret=

# mirelab-realtime 릴레이와 나눠 쓰는 값. 릴레이 쪽 INTERNAL_SECRET 과 같아야 한다.
# 예: openssl rand -hex 32
mirelab.internal-secret=

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
# 승인된 리디렉션 URI 에 접속 경로마다 하나씩, 글자 그대로 등록한다:
#   http://localhost:5173/api/login/oauth2/code/google
#   https://yeongseo-mini-s.taildf0713.ts.net/api/login/oauth2/code/google
# 어느 쪽으로 접속할지는 mirelab.public-base-url 이 정한다(기본값은 localhost:5173).
# admin의 /@username 주소는 MIRELAB_ADMIN_USERNAME 환경변수로 지정한다(기본값: yeongseo).
#
# 값을 받기 전까지는 아래 두 줄을 주석으로 둔다 — 빈 문자열로 남기면 이 파일이
# application.properties 의 ${GOOGLE_CLIENT_ID:...} 를 덮어써서, 환경변수로 넣어준
# 값까지 무력화되고 Spring 이 ClientRegistration 을 못 만들어 부팅을 실패한다.
#
#spring.security.oauth2.client.registration.google.client-id=
#spring.security.oauth2.client.registration.google.client-secret=
