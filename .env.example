POSTGRES_DB=mirelab
POSTGRES_USER=mirelab
POSTGRES_PASSWORD=changeme

# 알라딘 도서 검색 API 키 — 비어있으면 도서 검색 호출 시 예외가 난다
ALADIN_TTB_KEY=

# ── 인증 ───────────────────────────────────────────────────────────────────
# docker-compose.dev.yml 은 아래가 전부 비어 있어도 더미 기본값으로 뜬다(실제 구글
# 로그인만 안 된다). docker-compose.yml(운영)은 비어 있으면 시작을 거부한다.

# 브라우저가 접근하는 공개 주소. 구글 콘솔의 "승인된 리디렉션 URI" 에
#   <이 주소>/api/login/oauth2/code/google
# 를 글자 그대로 등록해야 한다. 접속 경로가 여럿이면 콘솔에 각각 등록하고,
# 여기 값은 그중 지금 쓰는 하나로 맞춘다.
#   로컬:      http://localhost:5173
#   tailscale: https://yeongseo-mini-s.taildf0713.ts.net
MIRELAB_PUBLIC_BASE_URL=http://localhost:5173

# https 로 서비스하면 true (refresh 쿠키에 Secure 를 붙인다). 로컬 http 는 false.
MIRELAB_COOKIE_SECURE=false

# 이 구글 계정으로 로그인한 사람이 가입 신청을 승인하는 admin 이 된다
MIRELAB_ADMIN_EMAIL=pj0642@gmail.com

# access token 서명 키 — 32바이트(256bit) 이상. 예: openssl rand -base64 48
MIRELAB_JWT_SECRET=

# 백엔드와 실시간 릴레이가 나눠 쓰는 값(compose 가 양쪽에 같은 변수를 넣어준다).
# 예: openssl rand -hex 32
MIRELAB_INTERNAL_SECRET=

# Google Cloud Console > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
